[flake8]
# Flake8 configuration for code style enforcement

max-line-length = 127
max-complexity = 10

# Exclude patterns
exclude =
    .git,
    __pycache__,
    venv,
    env,
    .venv,
    build,
    dist,
    *.egg-info,
    .pytest_cache,
    .mypy_cache,
    node_modules,
    frontend

# Error codes to ignore
ignore =
    E203,  # whitespace before ':'
    E501,  # line too long (handled by max-line-length)
    W503,  # line break before binary operator
    W504,  # line break after binary operator

# Select specific error codes
select = E,W,F,C

# Per-file ignores
per-file-ignores =
    __init__.py:F401
    */tests/*:F401,F811

# Show source code for errors
show-source = True

# Show statistics
statistics = True

# Count errors
count = True
